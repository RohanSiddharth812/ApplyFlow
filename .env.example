# ApplyFlow Environment Configuration
# Copy this file to .env and fill in your real values.
# The app works fully with USE_MOCK_AI=true (default) — no API key needed.

# ─── AI Provider ───────────────────────────────────────────────────────────────
# Set to "false" to use the real OpenAI-compatible API (requires AI_API_KEY below)
USE_MOCK_AI=true

# Provider API key — only needed when USE_MOCK_AI=false
AI_API_KEY=

# Model and endpoint used by the backend AI provider
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Keep enabled until a real job source adapter is configured
USE_MOCK_JOBS=true

# ─── Security ──────────────────────────────────────────────────────────────────
# Change this to a long random string in production!
SECRET_KEY=replace-with-a-long-random-ApplyFlow-secret-before-deployment

# ─── App Settings ──────────────────────────────────────────────────────────────
# Environment: development | production
APP_ENV=development

# Local SQLite default (override with a PostgreSQL URL in production)
DATABASE_URL=sqlite:///./applyflow.db

# Brevo email verification (keep the real API key in backend/.env, never in frontend)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ApplyFlow
FRONTEND_BASE_URL=http://127.0.0.1:5173
EMAIL_VERIFICATION_TTL_MINUTES=1440

# CORS allowed origins (JSON array)
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# ─── File Storage ──────────────────────────────────────────────────────────────
# Directory where uploaded resumes are stored (relative to backend/)
UPLOAD_DIR=uploads
